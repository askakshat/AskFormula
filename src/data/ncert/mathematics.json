{
  "subject": "Mathematics",
  "class": "11",
  "audience": ["school", "jee", "neet"],
  "chapters": [
    {
      "id": "ch1",
      "class": "11",
      "name": "Sets",
      "formulas": [
        { "id": "m1_1", "name": "Union Cardinality", "latex": "n(A \\cup B) = n(A) + n(B) - n(A \\cap B)", "tags": ["sets", "cardinality"] },
        { "id": "m1_2", "name": "De Morgan's First Law", "latex": "(A \\cup B)' = A' \\cap B'", "tags": ["sets", "demorgan"] },
        { "id": "m1_3", "name": "De Morgan's Second Law", "latex": "(A \\cap B)' = A' \\cup B'", "tags": ["sets", "demorgan"] },
        { "id": "m1_4", "name": "Power Set", "latex": "n(P(A)) = 2^n", "tags": ["sets", "powerset"] },
        { "id": "m1_5", "name": "Cartesian Product Size", "latex": "n(A \\times B) = n(A) \\times n(B)", "tags": ["sets", "cartesian"] }
      ]
    },
    {
      "id": "ch2",
      "class": "11",
      "name": "Relations and Functions",
      "formulas": [
        { "id": "m2_1", "name": "Total Relations", "latex": "2^{pq}", "tags": ["relations", "counting"] },
        { "id": "m2_2", "name": "Function Composition", "latex": "(f \\circ g)(x) = f(g(x))", "tags": ["functions", "composition"] }
      ]
    },
    {
      "id": "ch3",
      "class": "11",
      "name": "Trigonometric Functions",
      "formulas": [
        { "id": "m3_1", "name": "Radian-Degree Conversion", "latex": "\\text{Radian} = \\frac{\\pi}{180} \\times \\text{Degree}", "tags": ["trigo", "angles"] },
        { "id": "m3_2", "name": "Arc Length", "latex": "l = r\\theta", "tags": ["trigo", "circle"] },
        { "id": "m3_3", "name": "sin(x+y)", "latex": "\\sin(x+y) = \\sin x \\cos y + \\cos x \\sin y", "tags": ["trigo", "sum"] },
        { "id": "m3_4", "name": "cos(x+y)", "latex": "\\cos(x+y) = \\cos x \\cos y - \\sin x \\sin y", "tags": ["trigo", "sum"] },
        { "id": "m3_5", "name": "sin(2x)", "latex": "\\sin 2x = 2\\sin x \\cos x", "tags": ["trigo", "double"] },
        { "id": "m3_6", "name": "cos(2x)", "latex": "\\cos 2x = \\cos^2 x - \\sin^2 x", "tags": ["trigo", "double"] },
        { "id": "m3_7", "name": "Pythagorean Identity", "latex": "\\sin^2 x + \\cos^2 x = 1", "tags": ["trigo", "identity"] }
      ]
    },
    {
      "id": "ch4",
      "class": "11",
      "name": "Principle of Mathematical Induction",
      "formulas": [
        { "id": "m4_1", "name": "Induction Steps", "latex": "P(1) \\text{ true} \\land P(k) \\Rightarrow P(k+1) \\Rightarrow P(n) \\forall n", "tags": ["induction", "proof"] },
        { "id": "m4_2", "name": "Sum of first n natural numbers", "latex": "\\sum_{i=1}^{n} i = \\frac{n(n+1)}{2}", "tags": ["induction", "series"] }
      ]
    },
    {
      "id": "ch5",
      "class": "11",
      "name": "Complex Numbers and Quadratic Equations",
      "formulas": [
        { "id": "m5_1", "name": "Imaginary Unit", "latex": "i^2 = -1", "tags": ["complex", "imaginary"] },
        { "id": "m5_2", "name": "Modulus", "latex": "|z| = \\sqrt{a^2 + b^2}", "tags": ["complex", "modulus"] },
        { "id": "m5_3", "name": "Conjugate", "latex": "\\bar{z} = a - ib", "tags": ["complex", "conjugate"] },
        { "id": "m5_4", "name": "Quadratic Formula", "latex": "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}", "tags": ["quadratic", "roots"] }
      ]
    },
    {
      "id": "ch6",
      "class": "11",
      "name": "Linear Inequalities",
      "formulas": [
        { "id": "m6_1", "name": "Triangle Inequality", "latex": "|a + b| \\le |a| + |b|", "tags": ["inequalities", "modulus"] }
      ]
    },
    {
      "id": "ch7",
      "class": "11",
      "name": "Permutations and Combinations",
      "formulas": [
        { "id": "m7_1", "name": "Factorial", "latex": "n! = n \\times (n-1) \\times ... \\times 1", "tags": ["pnc", "factorial"] },
        { "id": "m7_2", "name": "Permutation (nPr)", "latex": "^nP_r = \\frac{n!}{(n-r)!}", "tags": ["pnc", "permutation"] },
        { "id": "m7_3", "name": "Combination (nCr)", "latex": "^nC_r = \\frac{n!}{r!(n-r)!}", "tags": ["pnc", "combination"] }
      ]
    },
    {
      "id": "ch8",
      "class": "11",
      "name": "Binomial Theorem",
      "formulas": [
        { "id": "m8_1", "name": "Binomial Expansion", "latex": "(a+b)^n = \\sum_{k=0}^{n} ^nC_k a^{n-k} b^k", "tags": ["binomial", "expansion"] },
        { "id": "m8_2", "name": "General Term", "latex": "T_{r+1} = ^nC_r a^{n-r} b^r", "tags": ["binomial", "general"] }
      ]
    },
    {
      "id": "ch9",
      "class": "11",
      "name": "Sequences and Series",
      "formulas": [
        { "id": "m9_1", "name": "nth term of AP", "latex": "a_n = a + (n-1)d", "tags": ["sequence", "ap"] },
        { "id": "m9_2", "name": "Sum of n terms AP", "latex": "S_n = \\frac{n}{2}[2a + (n-1)d]", "tags": ["series", "ap"] },
        { "id": "m9_3", "name": "nth term of GP", "latex": "a_n = a r^{n-1}", "tags": ["sequence", "gp"] },
        { "id": "m9_4", "name": "Sum of n terms GP", "latex": "S_n = \\frac{a(r^n - 1)}{r - 1}", "tags": ["series", "gp"] },
        { "id": "m9_5", "name": "Sum of infinite GP", "latex": "S_\\infty = \\frac{a}{1 - r}", "tags": ["series", "gp", "infinite"] }
      ]
    },
    {
      "id": "ch10",
      "class": "11",
      "name": "Straight Lines",
      "formulas": [
        { "id": "m10_1", "name": "Distance Formula", "latex": "d = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2}", "tags": ["lines", "distance"] },
        { "id": "m10_2", "name": "Slope", "latex": "m = \\frac{y_2 - y_1}{x_2 - x_1} = \\tan \\theta", "tags": ["lines", "slope"] },
        { "id": "m10_3", "name": "Point-Slope Form", "latex": "y - y_1 = m(x - x_1)", "tags": ["lines", "equation"] },
        { "id": "m10_4", "name": "Distance of point from line", "latex": "d = \\frac{|Ax_1 + By_1 + C|}{\\sqrt{A^2 + B^2}}", "tags": ["lines", "distance"] }
      ]
    },
    {
      "id": "ch11",
      "class": "11",
      "name": "Conic Sections",
      "formulas": [
        { "id": "m11_1", "name": "Circle Equation", "latex": "(x - h)^2 + (y - k)^2 = r^2", "tags": ["conics", "circle"] },
        { "id": "m11_2", "name": "Parabola (Standard)", "latex": "y^2 = 4ax", "tags": ["conics", "parabola"] },
        { "id": "m11_3", "name": "Ellipse (Standard)", "latex": "\\frac{x^2}{a^2} + \\frac{y^2}{b^2} = 1", "tags": ["conics", "ellipse"] },
        { "id": "m11_4", "name": "Hyperbola (Standard)", "latex": "\\frac{x^2}{a^2} - \\frac{y^2}{b^2} = 1", "tags": ["conics", "hyperbola"] }
      ]
    },
    {
      "id": "ch12",
      "class": "11",
      "name": "Introduction to Three Dimensional Geometry",
      "formulas": [
        { "id": "m12_1", "name": "3D Distance Formula", "latex": "d = \\sqrt{(x_2 - x_1)^2 + (y_2 - y_1)^2 + (z_2 - z_1)^2}", "tags": ["3d", "distance"] },
        { "id": "m12_2", "name": "Section Formula", "latex": "x = \\frac{mx_2 + nx_1}{m+n}", "tags": ["3d", "section"] }
      ]
    },
    {
      "id": "ch13",
      "class": "11",
      "name": "Limits and Derivatives",
      "formulas": [
        { "id": "m13_1", "name": "Standard Limit (Algebraic)", "latex": "\\lim_{x \\to a} \\frac{x^n - a^n}{x - a} = n a^{n-1}", "tags": ["limits", "algebraic"] },
        { "id": "m13_2", "name": "Standard Limit (Trigo)", "latex": "\\lim_{x \\to 0} \\frac{\\sin x}{x} = 1", "tags": ["limits", "trigo"] },
        { "id": "m13_3", "name": "First Principle of Derivative", "latex": "f'(x) = \\lim_{h \\to 0} \\frac{f(x+h) - f(x)}{h}", "tags": ["derivatives", "first-principle"] },
        { "id": "m13_4", "name": "Product Rule", "latex": "(uv)' = u'v + uv'", "tags": ["derivatives", "rules"] },
        { "id": "m13_5", "name": "Quotient Rule", "latex": "\\left(\\frac{u}{v}\\right)' = \\frac{u'v - uv'}{v^2}", "tags": ["derivatives", "rules"] }
      ]
    },
    {
      "id": "ch14",
      "class": "11",
      "name": "Mathematical Reasoning",
      "formulas": [
        { "id": "m14_1", "name": "Contrapositive", "latex": "p \\Rightarrow q \\equiv \\sim q \\Rightarrow \\sim p", "tags": ["reasoning", "logic"] },
        { "id": "m14_2", "name": "Converse", "latex": "p \\Rightarrow q \\text{ has converse } q \\Rightarrow p", "tags": ["reasoning", "logic"] }
      ]
    },
    {
      "id": "ch15",
      "class": "11",
      "name": "Statistics",
      "formulas": [
        { "id": "m15_1", "name": "Mean", "latex": "\\bar{x} = \\frac{1}{n} \\sum_{i=1}^{n} x_i", "tags": ["stats", "mean"] },
        { "id": "m15_2", "name": "Variance", "latex": "\\sigma^2 = \\frac{1}{n} \\sum_{i=1}^{n} (x_i - \\bar{x})^2", "tags": ["stats", "variance"] },
        { "id": "m15_3", "name": "Standard Deviation", "latex": "\\sigma = \\sqrt{\\frac{1}{n} \\sum_{i=1}^{n} (x_i - \\bar{x})^2}", "tags": ["stats", "deviation"] },
        { "id": "m15_4", "name": "Coefficient of Variation", "latex": "CV = \\frac{\\sigma}{\\bar{x}} \\times 100", "tags": ["stats", "cv"] }
      ]
    },
    {
      "id": "ch16",
      "class": "11",
      "name": "Probability",
      "formulas": [
        { "id": "m16_1", "name": "Probability of Event", "latex": "P(E) = \\frac{n(E)}{n(S)}", "tags": ["probability", "event"] },
        { "id": "m16_2", "name": "Addition Theorem", "latex": "P(A \\cup B) = P(A) + P(B) - P(A \\cap B)", "tags": ["probability", "addition"] },
        { "id": "m16_3", "name": "Mutually Exclusive Events", "latex": "P(A \\cup B) = P(A) + P(B)", "tags": ["probability", "exclusive"] }
      ]
    }
  ]
}
