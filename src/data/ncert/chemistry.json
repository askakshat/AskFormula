            "equilibrium constant",
            "kc",
            "kp"
          ]
        },
        {
          "id": "c6_2",
          "name": "Relation between Kp and Kc",
          "latex": "K_p = K_c (RT)^{\\Delta n_g}",
          "tags": [
            "kp",
            "kc",
            "relation"
          ]
        },
        {
          "id": "c6_3",
          "name": "van 't Hoff Equation",
          "latex": "\\log\\left(\\frac{K_2}{K_1}\\right) = \\frac{\\Delta_r H^\\circ}{2.303 R}\\left[\\frac{T_2 - T_1}{T_1 T_2}\\right]",
          "tags": [
            "van t hoff",
            "equilibrium",
            "temperature"
          ]
        },
        {
          "id": "c6_4",
          "name": "Degree of Dissociation",
          "latex": "\\alpha = \\frac{D - d}{(n-1)d} = \\frac{M_{\\text{th}} - M_{\\text{obs}}}{(n-1)M_{\\text{obs}}}",
          "tags": [
            "degree of dissociation"
          ]
        },
        {
          "id": "c6_5",
          "name": "Ionic Product of Water",
          "latex": "K_w = [\\text{H}^+][\\text{OH}^-] = 1.0 \\times 10^{-14}, \\qquad \\text{pH} + \\text{pOH} = 14",
          "tags": [
            "ionic product",
            "water",
            "ph"
          ]
        },
        {
          "id": "c6_6",
          "name": "Ostwald's Dilution Law",
          "latex": "K_a = \\frac{C\\alpha^2}{1 - \\alpha} \\approx C\\alpha^2 \\implies \\alpha = \\sqrt{\\frac{K_a}{C}}",
          "tags": [
            "ostwald",
            "dilution law"
          ]
        },
        {
          "id": "c6_7",
          "name": "Hydrogen Ion Concentration",
          "latex": "[\\text{H}^+] = C\\alpha = \\sqrt{K_a C}",
          "tags": [
            "hydrogen ion",
            "concentration"
          ]
        },
        {
          "id": "c6_8",
          "name": "Salt Hydrolysis (WA + SB)",
          "latex": "h = \\sqrt{\\frac{K_w}{K_a C}}, \\qquad \\text{pH} = 7 + \\frac{1}{2}\\text{pK}_a + \\frac{1}{2}\\log C",
