          "tags": [
            "salt hydrolysis",
            "weak acid",
            "weak base"
          ]
        },
        {
          "id": "c6_11",
          "name": "Acidic Buffer (Henderson-Hasselbalch)",
          "latex": "\\text{pH} = \\text{pK}_a + \\log\\left(\\frac{[\\text{Conjugate Base}]}{[\\text{Weak Acid}]}\\right)",
