            "basic",
            "henderson-hasselbalch"
          ]
        },
        {
          "id": "c6_13",
          "name": "Solubility Product (Ksp)",
          "latex": "K_{sp} = [A^{y+}]^x [B^{x-}]^y = (xs)^x (ys)^y = x^x y^y s^{x+y}",
