    {
      "id": "chem_ch4",
      "class": "11",
      "name": "Chemical Bonding and Molecular Structure",
      "formulas": [
        {
          "id": "c4_1",
          "name": "Formal Charge (F.C.)",
          "latex": "\\text{F.C.} = V - N_{\\text{non-bonding}} - \\frac{1}{2}N_{\\text{bonding}} = V - L - \\frac{1}{2}B",
          "tags": [
            "formal charge",
            "bonding"
          ]
        },
        {
          "id": "c4_2",
          "name": "Dipole Moment (\\mu)",
          "latex": "\\mu = q \\times d, \\quad 1\\text{ D} = 3.33564 \\times 10^{-30}\\text{ C}\\cdot\\text{m} = 10^{-18}\\text{ esu}\\cdot\\text{cm}",
          "tags": [
            "dipole moment",
            "bonding"
          ]
        },
        {
          "id": "c4_3",
          "name": "Linear Combination of Atomic Orbitals (LCAO)",
          "latex": "\\psi_{\\text{MO}} = \\psi_A \\pm \\psi_B \\implies \\psi_{\\sigma} = \\psi_A + \\psi_B \\; (\\text{Bonding}), \\quad \\psi_{\\sigma^*} = \\psi_A - \\psi_B \\; (\\text{Antibonding})",
          "tags": [
            "mot",
            "molecular orbital"
          ]
        },
        {
          "id": "c4_4",
          "name": "Bond Order",
          "latex": "\\text{Bond Order} = \\frac{1}{2}(N_b - N_a)",
          "tags": [
            "bond order",
            "mot"
          ]
        }
      ]
    },
    {
      "id": "chem_ch5",
      "class": "11",
      "name": "States of Matter",
      "formulas": [
        {
          "id": "c5_1",
          "name": "Boyle's Law (Pressure-Volume Relationship)",
          "latex": "P \\propto \\frac{1}{V} \\implies P_1 V_1 = P_2 V_2 \\quad (\\text{at constant } T, n)",
          "tags": [
            "boyle",
            "gas law"
          ]
        },
        {
          "id": "c5_2",
          "name": "Density Relation from Boyle's Law",
          "latex": "d = \\left[\\frac{m}{k_1}\\right]P \\implies d \\propto P",
          "tags": [
            "density",
            "gas law"
          ]
        },
        {
          "id": "c5_3",
          "name": "Charles's Law (Temperature-Volume Relationship)",
          "latex": "V \\propto T \\implies \\frac{V_1}{T_1} = \\frac{V_2}{T_2} \\quad (\\text{at constant } P, n)",
          "tags": [
            "charles",
            "gas law"
          ]
        },
        {
          "id": "c5_4",
          "name": "Gay-Lussac's Law (Pressure-Temperature Relationship)",
          "latex": "P \\propto T \\implies \\frac{P_1}{T_1} = \\frac{P_2}{T_2} \\quad (\\text{at constant } V, n)",
          "tags": [
            "gay lussac",
            "gas law"
          ]
        },
        {
          "id": "c5_5",
          "name": "Avogadro's Law (Volume-Amount Relationship)",
          "latex": "V \\propto n \\implies V = k_4 n \\quad (\\text{at constant } T, P)",
          "tags": [
            "avogadro",
            "gas law"
          ]
        },
        {
          "id": "c5_6",
          "name": "Ideal Gas Equation",
          "latex": "PV = nRT = \\frac{m}{M}RT",
          "tags": [
            "ideal gas",
            "thermodynamics"
          ]
        },
        {
          "id": "c5_7",
          "name": "Combined Gas Law",
          "latex": "\\frac{P_1 V_1}{T_1} = \\frac{P_2 V_2}{T_2}",
          "tags": [
            "gas law",
            "combined"
          ]
        },
        {
          "id": "c5_8",
          "name": "Molar Mass from Gas Density",
          "latex": "M = \\frac{dRT}{P}",
          "tags": [
            "density",
            "molar mass"
          ]
        },
        {
          "id": "c5_9",
          "name": "Dalton's Law of Partial Pressures & Aqueous Tension",
          "latex": "P_{\\text{total}} = \\sum P_i = P_1 + P_2 + P_3 + \\dots, \\quad P_{\\text{dry gas}} = P_{\\text{total}} - \\text{Aqueous Tension}",
          "tags": [
            "dalton",
            "partial pressure"
          ]
        },
        {
          "id": "c5_10",
          "name": "Partial Pressure in terms of Mole Fraction",
          "latex": "P_i = \\chi_i P_{\\text{total}}",
          "tags": [
            "partial pressure",
            "mole fraction"
          ]
        },
        {
          "id": "c5_11",
          "name": "Kinetic Gas Equation",
          "latex": "PV = \\frac{1}{3} m N u_{\\text{rms}}^2 = \\frac{1}{3} M_{\\text{total}} u_{\\text{rms}}^2",
          "tags": [
            "kinetic theory",
            "rms"
          ]
        },
        {
          "id": "c5_12",
          "name": "Kinetic Energy of Gas Molecules",
          "latex": "E_{k(\\text{per molecule})} = \\frac{3}{2}k_B T, \\quad E_{k(\\text{per mole})} = \\frac{3}{2}RT",
          "tags": [
            "kinetic energy",
            "gas"
          ]
        },
        {
          "id": "c5_13",
          "name": "Root Mean Square (RMS) Speed",
          "latex": "u_{\\text{rms}} = \\sqrt{\\frac{\\sum u_i^2}{n}} = \\sqrt{\\frac{3RT}{M}} = \\sqrt{\\frac{3P}{\\rho}}",
          "tags": [
            "rms speed",
            "kinetic theory"
          ]
        },
        {
          "id": "c5_14",
          "name": "Average Speed (u_av)",
          "latex": "u_{\\text{av}} = \\frac{\\sum u_i}{n} = \\sqrt{\\frac{8RT}{\\pi M}} = \\sqrt{\\frac{8P}{\\pi \\rho}}",
          "tags": [
            "average speed",
            "kinetic theory"
          ]
        },
        {
          "id": "c5_15",
          "name": "Most Probable Speed (u_mp)",
          "latex": "u_{\\text{mp}} = \\sqrt{\\frac{2RT}{M}} = \\sqrt{\\frac{2P}{\\rho}}",
          "tags": [
            "probable speed",
            "kinetic theory"
          ]
        },
        {
          "id": "c5_16",
          "name": "Ratio & Comparison of Molecular Speeds",
          "latex": "u_{\\text{rms}} > u_{\\text{av}} > u_{\\text{mp}}, \\quad u_{\\text{mp}} : u_{\\text{av}} : u_{\\text{rms}} = 1 : 1.128 : 1.224 = \\sqrt{2} : \\sqrt{\\frac{8}{\\pi}} : \\sqrt{3}",
          "tags": [
            "speed ratio",
            "kinetic theory"
          ]
        },
        {
          "id": "c5_17",
          "name": "Maxwell-Boltzmann Speed Distribution Law",
          "latex": "\\frac{dn_c}{n} = 4\\pi \\left[\\frac{M}{2\\pi RT}\\right]^{3/2} c^2 e^{-\\frac{Mc^2}{2RT}} dc",
          "tags": [
            "maxwell boltzmann",
            "distribution"
          ]
        },
        {
          "id": "c5_18",
          "name": "Graham's Law of Diffusion",
          "latex": "\\frac{r_1}{r_2} = \\sqrt{\\frac{d_2}{d_1}} = \\sqrt{\\frac{M_2}{M_1}} = \\frac{V_1 / t_1}{V_2 / t_2}",
          "tags": [
            "graham",
            "diffusion"
          ]
        },
        {
          "id": "c5_19",
          "name": "Compressibility Factor (Z)",
          "latex": "Z = \\frac{PV}{nRT} = \\frac{V_{\\text{real}}}{V_{\\text{ideal}}} \\quad (Z=1 \\text{ for ideal gas})",
          "tags": [
            "compressibility",
            "real gas"
          ]
        },
        {
          "id": "c5_20",
          "name": "Van der Waals Equation of State",
          "latex": "\\left[P + \\frac{a n^2}{V^2}\\right](V - nb) = nRT \\implies \\left[P + \\frac{a}{V_m^2}\\right](V_m - b) = RT",
          "tags": [
            "van der waals",
            "real gas"
          ]
        },
        {
          "id": "c5_21",
          "name": "Viscosity & Fluidity",
          "latex": "F = \\eta A \\frac{du}{dz}, \\quad \\text{Fluidity} = \\frac{1}{\\eta}",
          "tags": [
            "viscosity",
            "fluidity"
          ]
        }
      ]
    },
    {
      "id": "chem_ch6",
      "class": "11",
      "name": "Thermodynamics",
      "formulas": [
        {
          "id": "c6_1",
          "name": "First Law of Thermodynamics",
          "latex": "\\Delta U = q + w",
          "tags": [
            "first law",
            "internal energy"
          ]
        },
        {
          "id": "c6_2",
          "name": "Expansion Work & Free Expansion",
          "latex": "w_{\\text{rev}} = -\\int_{V_i}^{V_f} P_{\\text{ext}} dV = -2.303 nRT \\log_{10}\\left(\\frac{V_f}{V_i}\\right), \\quad w_{\\text{free}} = 0 \\; (P_{\\text{ext}}=0)",
          "tags": [
            "work",
            "expansion",
            "free"
          ]
        },
        {
          "id": "c6_3",
          "name": "Enthalpy and Internal Energy Relation",
          "latex": "\\Delta H = \\Delta U + \\Delta n_g RT",
          "tags": [
            "enthalpy",
            "thermodynamics"
          ]
        },
        {
          "id": "c6_4",
          "name": "Heat Capacity & Molar Heat Capacity",
          "latex": "q = C \\Delta T, \\quad C_m = \\frac{C}{n}, \\quad C_p - C_v = R",
          "tags": [
            "heat capacity",
            "gas constant"
          ]
        },
        {
          "id": "c6_5",
          "name": "Enthalpy of Reaction from Formation Enthalpies",
          "latex": "\\Delta_r H^\\circ = \\sum a_i \\Delta_f H^\\circ(\\text{Products}) - \\sum b_i \\Delta_f H^\\circ(\\text{Reactants})",
          "tags": [
            "enthalpy",
            "reaction",
            "hess"
          ]
        },
        {
          "id": "c6_6",
          "name": "Enthalpy of Reaction from Bond Enthalpies",
          "latex": "\\Delta_r H^\\circ = \\sum \\text{B.E.}(\\text{Reactants}) - \\sum \\text{B.E.}(\\text{Products})",
          "tags": [
            "enthalpy",
            "bond"
          ]
        },
        {
          "id": "c6_7",
          "name": "Enthalpy of Solution (Born-Haber Cycle)",
          "latex": "\\Delta_{\\text{sol}} H^\\circ = \\Delta_{\\text{lattice}} H^\\circ + \\Delta_{\\text{hyd}} H^\\circ",
          "tags": [
            "enthalpy",
            "solution",
            "born-haber"
          ]
        },
        {
          "id": "c6_8",
          "name": "Entropy Change & Total Entropy",
