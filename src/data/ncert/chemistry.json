        {
          "id": "c2_15",
          "name": "Nodes",
          "latex": "\\text{Radial Nodes} = n - l - 1, \\qquad \\text{Angular Nodes} = l, \\qquad \\text{Total Nodes} = n - 1",
          "tags": [
