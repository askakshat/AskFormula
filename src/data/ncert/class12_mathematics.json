      "name": "Inverse Trigonometric Functions",
      "keyPoints": [],
      "keyDerivations": [],
      "formulas": [
        {
          "id": "fm_2_1",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Self-Inversion (Sin)",
          "latex": "\\sin(\\sin^{-1}x) = x, \\; x \\in [-1, 1] \\qquad \\sin^{-1}(\\sin x) = x, \\; x \\in \\left[-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right]",
          "tags": []
        },
        {
          "id": "fm_2_2",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Self-Inversion (Cos)",
          "latex": "\\cos(\\cos^{-1}x) = x, \\; x \\in [-1, 1] \\qquad \\cos^{-1}(\\cos x) = x, \\; x \\in [0, \\pi]",
          "tags": []
        },
        {
          "id": "fm_2_3",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Self-Inversion (Tan)",
          "latex": "\\tan(\\tan^{-1}x) = x, \\; x \\in \\mathbb{R} \\qquad \\tan^{-1}(\\tan x) = x, \\; x \\in \\left(-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right)",
          "tags": []
        },
        {
          "id": "fm_2_4",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Negative Arguments (Sin, Tan, Csc)",
          "latex": "\\sin^{-1}(-x) = -\\sin^{-1}x, \\quad \\tan^{-1}(-x) = -\\tan^{-1}x, \\quad \\csc^{-1}(-x) = -\\csc^{-1}x",
          "tags": []
        },
        {
          "id": "fm_2_5",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Negative Arguments (Cos, Cot, Sec)",
          "latex": "\\cos^{-1}(-x) = \\pi - \\cos^{-1}x, \\quad \\cot^{-1}(-x) = \\pi - \\cot^{-1}x, \\quad \\sec^{-1}(-x) = \\pi - \\sec^{-1}x",
          "tags": []
        },
        {
          "id": "fm_2_6",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Reciprocal Identities",
          "latex": "\\csc^{-1}x = \\sin^{-1}\\left(\\frac{1}{x}\\right), \\qquad \\sec^{-1}x = \\cos^{-1}\\left(\\frac{1}{x}\\right)",
          "tags": []
        },
        {
          "id": "fm_2_7",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Complementary Angles",
          "latex": "\\sin^{-1}x + \\cos^{-1}x = \\frac{\\pi}{2}, \\qquad \\tan^{-1}x + \\cot^{-1}x = \\frac{\\pi}{2}, \\qquad \\sec^{-1}x + \\csc^{-1}x = \\frac{\\pi}{2}",
          "tags": []
        },
        {
          "id": "fm_2_8",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Multiple Angle Relations (Tan)",
          "latex": "2\\tan^{-1}x = \\sin^{-1}\\left(\\frac{2x}{1+x^2}\\right) = \\cos^{-1}\\left(\\frac{1-x^2}{1+x^2}\\right) = \\tan^{-1}\\left(\\frac{2x}{1-x^2}\\right)",
          "tags": []
        },
        {
          "id": "fm_2_9",
          "chapter": "Inverse Trigonometric Functions",
          "name": "Multiple Angle Relations (Sin)",
          "latex": "2\\sin^{-1}x = \\sin^{-1}\\left(2x\\sqrt{1-x^2}\\right) \\qquad 3\\sin^{-1}x = \\sin^{-1}(3x - 4x^3)",
          "tags": []
        }
      ],
      "class": "12"
