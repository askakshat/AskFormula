    {
      "id": "c12_m_3",
      "name": "Matrices",
      "keyPoints": [
        "Decomposition Theorem: Every square matrix A can be uniquely expressed as the sum of a symmetric and a skew-symmetric matrix: $A = \\frac{1}{2}(A + A') + \\frac{1}{2}(A - A')$",
        "Commutativity of Symmetric Matrices: If A and B are symmetric matrices, AB is symmetric $\\iff AB = BA$.",
        "Skew-Symmetry of Commutator: If A and B are symmetric, $AB - BA$ is always skew-symmetric: $(AB - BA)' = -(AB - BA)$"
      ],
      "keyDerivations": [],
      "formulas": [
        {
          "id": "fm_3_1",
          "chapter": "Matrices",
          "name": "Matrix Addition",
          "latex": "C = A + B \\implies c_{ij} = a_{ij} + b_{ij}",
          "tags": []
        },
        {
          "id": "fm_3_2",
          "chapter": "Matrices",
          "name": "Scalar Multiplication",
          "latex": "kA = [k \\cdot a_{ij}]_{m \\times n}",
          "tags": []
        },
        {
          "id": "fm_3_3",
          "chapter": "Matrices",
          "name": "Matrix Multiplication",
          "latex": "C = AB \\implies c_{ik} = \\sum_{j=1}^n a_{ij} b_{jk} \\qquad A_{m \\times n} \\text{ and } B_{n \\times p} \\implies C_{m \\times p}",
          "tags": []
        },
        {
          "id": "fm_3_4",
          "chapter": "Matrices",
          "name": "Transpose Properties",
          "latex": "(A')' = A, \\; (kA)' = k A', \\; (A \\pm B)' = A' \\pm B', \\; (AB)' = B'A'",
          "tags": []
        },
        {
          "id": "fm_3_5",
          "chapter": "Matrices",
          "name": "Symmetric Matrix",
          "latex": "A' = A \\implies a_{ij} = a_{ji}",
          "tags": []
        },
        {
          "id": "fm_3_6",
          "chapter": "Matrices",
          "name": "Skew-Symmetric Matrix",
          "latex": "A' = -A \\implies a_{ij} = -a_{ji} \\qquad \\text{All diagonal elements are zero}",
          "tags": []
        },
        {
          "id": "fm_3_7",
          "chapter": "Matrices",
          "name": "Orthogonal Matrix",
          "latex": "A A^T = A^T A = I",
          "tags": []
        },
        {
          "id": "fm_3_8",
          "chapter": "Matrices",
          "name": "Reversal Law of Inverse",
          "latex": "(AB)^{-1} = B^{-1}A^{-1}",
          "tags": []
        }
      ],
      "class": "12"
    },
    {
