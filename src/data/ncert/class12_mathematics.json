    {
      "id": "c12_m_1",
      "name": "Relations and Functions",
      "keyPoints": [
        "Number of relations on set A ($|A| = n$): $2^{n^2}$",
        "Number of reflexive relations: $2^{n(n-1)}$",
        "Number of symmetric relations: $2^{\\frac{n(n+1)}{2}}$",
        "Number of functions from A to B ($|A| = n, |B| = m$): $m^n$",
        "Number of bijections on a set of $n$ elements: $n!$"
      ],
      "keyDerivations": [],
      "formulas": [
        {
          "id": "fm_1_1",
          "chapter": "Relations and Functions",
          "name": "Empty Relation",
          "latex": "R = \\phi \\subset A \\times A \\qquad \\text{No element of A is related to any element of A.}",
          "tags": []
        },
        {
          "id": "fm_1_2",
          "chapter": "Relations and Functions",
          "name": "Universal Relation",
          "latex": "R = A \\times A \\qquad \\text{Every element of A is related to every element of A.}",
          "tags": []
        },
        {
          "id": "fm_1_3",
          "chapter": "Relations and Functions",
          "name": "Reflexive Relation",
          "latex": "(a, a) \\in R, \\quad \\forall a \\in A \\qquad \\text{Every element is related to itself.}",
          "tags": []
        },
        {
          "id": "fm_1_4",
          "chapter": "Relations and Functions",
          "name": "Symmetric Relation",
          "latex": "(a, b) \\in R \\implies (b, a) \\in R, \\quad \\forall a, b \\in A \\qquad \\text{Order in pairs can be reversed.}",
          "tags": []
        },
        {
          "id": "fm_1_5",
          "chapter": "Relations and Functions",
          "name": "Transitive Relation",
          "latex": "(a, b) \\in R \\text{ and } (b, c) \\in R \\implies (a, c) \\in R, \\quad \\forall a, b, c \\in A",
          "tags": []
        },
        {
          "id": "fm_1_6",
          "chapter": "Relations and Functions",
          "name": "Equivalence Class",
          "latex": "[a] = \\{x \\in A : (x, a) \\in R\\}",
          "tags": []
        },
        {
          "id": "fm_1_7",
          "chapter": "Relations and Functions",
          "name": "One-One (Injective)",
          "latex": "f(x_1) = f(x_2) \\implies x_1 = x_2, \\quad \\forall x_1, x_2 \\in X",
          "tags": []
        },
        {
          "id": "fm_1_8",
          "chapter": "Relations and Functions",
          "name": "Onto (Surjective)",
          "latex": "\\forall y \\in Y, \\; \\exists x \\in X \\text{ such that } f(x) = y \\qquad \\text{Range}(f) = \\text{Co-domain}(Y)",
          "tags": []
        },
        {
          "id": "fm_1_9",
          "chapter": "Relations and Functions",
          "name": "Composition of Functions",
          "latex": "(g \\circ f)(x) = g(f(x)), \\quad \\forall x \\in A",
          "tags": []
        },
        {
          "id": "fm_1_10",
          "chapter": "Relations and Functions",
          "name": "Invertible Function",
          "latex": "\\exists g: Y \\to X \\text{ such that } g \\circ f = I_X \\text{ and } f \\circ g = I_Y",
          "tags": []
        },
        {
          "id": "fm_1_11",
          "chapter": "Relations and Functions",
          "name": "Number of One-One Functions",
          "latex": "^mP_n = \\frac{m!}{(m-n)!} \\quad \\text{if } m \\ge n \\qquad \\text{0 if } m < n",
          "tags": []
        }
      ],
      "class": "12"
    },
    {
