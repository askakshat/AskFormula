      "name": "Determinants",
      "keyPoints": [
        "Unique Solution (Consistent): If $|A| \\ne 0 \\implies X = A^{-1}B = \\frac{1}{|A|}(\\text{adj } A)B$.",
        "No Solution (Inconsistent): If $|A| = 0$ and $(\\text{adj } A)B \\ne O$.",
        "Infinitely Many Solutions or Inconsistent: If $|A| = 0$ and $(\\text{adj } A)B = O$."
      ],
      "keyDerivations": [],
      "formulas": [
