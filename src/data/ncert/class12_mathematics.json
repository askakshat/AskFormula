    {
      "id": "c12_m_5",
      "name": "Continuity and Differentiability",
      "keyPoints": [
        "Relation: $f(x)$ differentiable at $c \\implies f(x)$ continuous at $c$. Converse is not generally true."
      ],
      "keyDerivations": [],
      "formulas": [
        {
          "id": "fm_5_1",
          "chapter": "Continuity and Differentiability",
          "name": "Continuity at x=c",
          "latex": "\\lim_{x \\to c^-} f(x) = \\lim_{x \\to c^+} f(x) = f(c)",
          "tags": []
        },
        {
          "id": "fm_5_2",
          "chapter": "Continuity and Differentiability",
          "name": "Differentiability at x=c",
          "latex": "f'(c) = \\lim_{h \\to 0} \\frac{f(c+h) - f(c)}{h} \\qquad \\text{LHD} = \\text{RHD}",
          "tags": []
        },
        {
          "id": "fm_5_3",
          "chapter": "Continuity and Differentiability",
          "name": "Chain Rule",
          "latex": "\\frac{dy}{dx} = \\frac{dy}{du} \\cdot \\frac{du}{dx}",
          "tags": []
        },
        {
          "id": "fm_5_4",
          "chapter": "Continuity and Differentiability",
          "name": "Product Rule",
          "latex": "(uv)' = u'v + uv'",
          "tags": []
        },
        {
          "id": "fm_5_5",
          "chapter": "Continuity and Differentiability",
          "name": "Quotient Rule",
          "latex": "\\left(\\frac{u}{v}\\right)' = \\frac{u'v - uv'}{v^2}",
          "tags": []
        },
        {
          "id": "fm_5_6",
          "chapter": "Continuity and Differentiability",
          "name": "Parametric Differentiation",
          "latex": "\\frac{dy}{dx} = \\frac{dy/dt}{dx/dt} = \\frac{g'(t)}{f'(t)}",
          "tags": []
        },
        {
          "id": "fm_5_7",
          "chapter": "Continuity and Differentiability",
          "name": "Parametric 2nd Derivative",
          "latex": "\\frac{d^2y}{dx^2} = \\frac{d}{dt}\\left(\\frac{dy}{dx}\\right) \\cdot \\frac{dt}{dx} = \\frac{\\frac{d}{dt}(y')}{x'(t)}",
          "tags": []
        },
        {
          "id": "fm_5_8",
          "chapter": "Continuity and Differentiability",
          "name": "Logarithmic Differentiation",
          "latex": "\\frac{d}{dx}[u^v] = u^v \\left[ v' \\ln u + \\frac{v \\cdot u'}{u} \\right]",
          "tags": []
        },
        {
          "id": "fm_5_9",
          "chapter": "Continuity and Differentiability",
          "name": "Trig Derivatives",
          "latex": "\\frac{d}{dx}(\\sin x) = \\cos x, \\quad \\frac{d}{dx}(\\cos x) = -\\sin x, \\quad \\frac{d}{dx}(\\tan x) = \\sec^2 x",
          "tags": []
        },
        {
          "id": "fm_5_10",
          "chapter": "Continuity and Differentiability",
          "name": "Inverse Trig Derivatives",
          "latex": "\\frac{d}{dx}(\\sin^{-1}x) = \\frac{1}{\\sqrt{1-x^2}}, \\quad \\frac{d}{dx}(\\tan^{-1}x) = \\frac{1}{1+x^2}",
          "tags": []
        },
        {
          "id": "fm_5_11",
          "chapter": "Continuity and Differentiability",
          "name": "Exponential & Log Derivatives",
          "latex": "\\frac{d}{dx}(e^x) = e^x, \\quad \\frac{d}{dx}(a^x) = a^x \\ln a, \\quad \\frac{d}{dx}(\\ln x) = \\frac{1}{x}",
          "tags": []
        }
      ],
      "class": "12"
