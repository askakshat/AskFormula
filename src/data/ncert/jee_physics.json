    {
      "id": "jee_p_ch10",
      "class": "11",
      "name": "Heat, Thermodynamics & Kinetic Theory of Gases",
      "formulas": [
        {
          "id": "jee_p_10_1",
          "name": "Thermal Expansion",
          "latex": "\\Delta L = \\alpha L \\Delta T, \\qquad \\Delta A = 2\\alpha A \\Delta T, \\qquad \\Delta V = 3\\alpha V \\Delta T",
          "tags": ["thermal expansion"]
        },
        {
          "id": "jee_p_10_2",
          "name": "Conduction current",
          "latex": "H = \\frac{dQ}{dt} = \\frac{KA(T_1 - T_2)}{L}",
          "description": "Series thermal resistance: Rth = L / (KA).",
          "tags": ["heat conduction"]
        },
        {
          "id": "jee_p_10_3",
          "name": "Stefan-Boltzmann Law",
          "latex": "H = e \\sigma A (T^4 - T_s^4)",
          "tags": ["radiation", "stefan boltzmann"]
        },
        {
          "id": "jee_p_10_4",
          "name": "Wien's Law",
          "latex": "\\lambda_m T = b = 2.898 \\times 10^{-3} \\text{ m K}",
          "tags": ["wiens law", "radiation"]
        },
        {
          "id": "jee_p_10_5",
          "name": "Kinetic Theory Gas Pressure",
          "latex": "p = \\frac{1}{3} \\rho v_{rms}^2 = \\frac{1}{3} n m v_{rms}^2",
          "tags": ["ktg", "pressure"]
        },
        {
          "id": "jee_p_10_6",
          "name": "Molecular Speeds",
          "latex": "v_{rms} = \\sqrt{\\frac{3RT}{M}}, \\qquad v_{avg} = \\sqrt{\\frac{8RT}{\\pi M}}, \\qquad v_{mp} = \\sqrt{\\frac{2RT}{M}}",
          "description": "Ratio: vmp : vavg : vrms = 1 : 1.128 : 1.224.",
          "tags": ["ktg", "molecular speeds"]
        },
        {
          "id": "jee_p_10_7",
          "name": "Mean free path",
          "latex": "\\lambda = \\frac{1}{\\sqrt{2} \\pi d^2 n}",
          "tags": ["ktg", "mean free path"]
        },
        {
          "id": "jee_p_10_8",
          "name": "Average KE per molecule",
          "latex": "E = \\frac{3}{2} k_B T",
          "tags": ["ktg", "kinetic energy"]
        },
        {
          "id": "jee_p_10_9",
          "name": "First Law of Thermodynamics",
          "latex": "dQ = dU + dW",
          "description": "dW = p dV",
          "tags": ["thermodynamics", "first law"]
        },
        {
          "id": "jee_p_10_10",
          "name": "Isothermal Work",
          "latex": "W = nRT \\ln\\left(\\frac{V_2}{V_1}\\right) = 2.303 nRT \\log\\left(\\frac{p_1}{p_2}\\right)",
          "tags": ["thermodynamics", "isothermal"]
        },
        {
          "id": "jee_p_10_11",
          "name": "Adiabatic Work",
