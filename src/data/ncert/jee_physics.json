          "tags": ["standing waves", "open pipe"]
        },
        {
          "id": "jee_p_8_9",
          "name": "Standing Waves (Closed pipe)",
          "latex": "\\nu_n = (2n + 1) \\left(\\frac{v}{4L}\\right)",
