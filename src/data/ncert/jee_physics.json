    {
      "id": "jee_p_ch7",
      "class": "11",
      "name": "Fluid Mechanics",
      "formulas": [
        {
          "id": "jee_p_7_1",
          "name": "Hydrostatic Pressure",
          "latex": "p = p_0 + \\rho gh",
          "tags": ["pressure", "fluid statics"]
        },
        {
          "id": "jee_p_7_2",
          "name": "Accelerated Fluid",
          "latex": "\\tan\\theta = \\frac{a_x}{g + a_y}",
          "description": "\u03b8 = angle of free surface with horizontal.",
          "tags": ["accelerated fluid", "fluid statics"]
        },
        {
          "id": "jee_p_7_3",
          "name": "Continuity Equation",
          "latex": "A_1 v_1 = A_2 v_2 = \\text{const}",
          "tags": ["continuity", "fluid dynamics"]
        },
        {
          "id": "jee_p_7_4",
          "name": "Bernoulli's Equation",
          "latex": "p + \\frac{1}{2}\\rho v^2 + \\rho gh = \\text{const}",
          "tags": ["bernoulli", "fluid dynamics"]
        },
        {
          "id": "jee_p_7_5",
          "name": "Efflux speed",
          "latex": "v = \\sqrt{2gh + \\frac{2(p - p_0)}{\\rho}}",
          "tags": ["efflux", "torricelli"]
        },
        {
          "id": "jee_p_7_6",
          "name": "Venturi meter",
          "latex": "v_1 = A_2\\sqrt{\\frac{2\\Delta p}{\\rho(A_1^2 - A_2^2)}}",
          "tags": ["venturi meter", "fluid dynamics"]
        },
        {
          "id": "jee_p_7_7",
          "name": "Viscous Force",
          "latex": "F = -\\eta A \\frac{dv}{dx}",
          "tags": ["viscosity"]
        },
        {
          "id": "jee_p_7_8",
          "name": "Stokes' Law",
          "latex": "F_{viscous} = 6\\pi\\eta r v",
          "tags": ["stokes law", "viscosity"]
        },
        {
          "id": "jee_p_7_9",
          "name": "Terminal velocity",
          "latex": "v_t = \\frac{2}{9} \\frac{r^2(\\rho - \\sigma)g}{\\eta}",
          "description": "\u03c1 = density of sphere, \u03c3 = density of medium.",
          "tags": ["terminal velocity", "viscosity"]
        },
        {
          "id": "jee_p_7_10",
          "name": "Surface Tension",
          "latex": "S = \\frac{F}{2l} = \\frac{\\Delta W}{\\Delta A}",
          "tags": ["surface tension"]
        },
        {
          "id": "jee_p_7_11",
          "name": "Excess Pressure",
          "latex": "\\Delta p = \\frac{2S}{R}",
          "description": "Liquid drop \u0394p = 2S/R; Soap bubble \u0394p = 4S/R",
          "tags": ["excess pressure", "surface tension"]
        },
        {
          "id": "jee_p_7_12",
          "name": "Capillary Rise",
          "latex": "h = \\frac{2S \\cos\\theta}{\\rho g r}",
          "description": "\u03b8 = contact angle; r = tube radius, R = meniscus radius (R = r/cos\u03b8).",
          "tags": ["capillary action", "surface tension"]
        }
      ]
    },
    {
      "id": "jee_p_ch8",
      "class": "11",
      "name": "Elasticity & Mechanical Waves",
      "formulas": [
        {
          "id": "jee_p_8_1",
          "name": "Moduli of Elasticity - Young's",
          "latex": "Y = \\frac{F/A}{\\Delta L/L}",
          "description": "Thermal stress: F/A = Y \u03b1 \u0394T. Poisson's ratio: \u03bd = -(\u0394d/d) / (\u0394L/L).",
          "tags": ["youngs modulus", "elasticity"]
        },
        {
          "id": "jee_p_8_2",
          "name": "Moduli of Elasticity - Bulk",
          "latex": "B = -\\frac{\\Delta p}{\\Delta V/V}",
          "description": "Compressibility k = 1/B",
          "tags": ["bulk modulus", "elasticity"]
        },
        {
          "id": "jee_p_8_3",
          "name": "Moduli of Elasticity - Shear",
          "latex": "G = \\frac{F/A}{\\theta}",
          "tags": ["shear modulus", "elasticity"]
        },
        {
          "id": "jee_p_8_4",
          "name": "Elastic energy density",
          "latex": "u = \\frac{1}{2} \\times \\text{stress} \\times \\text{strain} = \\frac{1}{2} Y \\varepsilon^2",
          "tags": ["elastic energy", "elasticity"]
        },
        {
          "id": "jee_p_8_5",
          "name": "Wave Speed - Transverse string",
          "latex": "v = \\sqrt{\\frac{T}{\\mu}}",
          "description": "\u03bc = mass per unit length.",
          "tags": ["wave speed", "string"]
        },
        {
          "id": "jee_p_8_6",
          "name": "Wave Speed - Sound (fluid & solid)",
          "latex": "v = \\sqrt{\\frac{B}{\\rho}}, \\qquad v = \\sqrt{\\frac{Y}{\\rho}}",
          "tags": ["speed of sound", "waves"]
        },
        {
          "id": "jee_p_8_7",
          "name": "Laplace formula for gas",
          "latex": "v = \\sqrt{\\frac{\\gamma p}{\\rho}} = \\sqrt{\\frac{\\gamma R T}{M}}",
          "description": "\u03b3 = adiabatic index (Cp/Cv).",
          "tags": ["laplace formula", "speed of sound"]
        },
        {
          "id": "jee_p_8_8",
          "name": "Standing Waves (String fixed / Open pipe)",
          "latex": "\\nu_n = n \\left(\\frac{v}{2L}\\right)",
