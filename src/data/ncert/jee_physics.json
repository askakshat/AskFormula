          "name": "Beats frequency",
          "latex": "\\nu_{beat} = |\\nu_1 - \\nu_2|",
          "tags": ["beats", "frequency"]
        },
        {
          "name": "SHM Displacement",
          "latex": "x = A \\sin(\\omega t + \\phi)",
          "tags": ["shm"],
          "id": "jee_p_ch9_add_11"
        },
        {
          "name": "SHM Period (Spring)",
          "latex": "T = 2\\pi\\sqrt{\\frac{m}{k}}",
