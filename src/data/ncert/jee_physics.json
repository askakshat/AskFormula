{
  "subject": "Physics",
  "audience": ["jee"],
  "chapters": [
    {
      "id": "jee_p_ch1",
      "class": "11",
      "name": "Kinematics (1D, 2D, Projectile & Relative Motion)",
      "formulas": [
        {
          "id": "jee_p_1_1",
          "name": "Instantaneous Motion",
          "latex": "v = \\frac{dr}{dt} = \\frac{dx}{dt}\\hat{i} + \\frac{dy}{dt}\\hat{j} + \\frac{dz}{dt}\\hat{k}",
          "description": "General 3D/1D calculus relations",
          "tags": ["kinematics", "velocity", "calculus"]
        },
        {
          "id": "jee_p_1_2",
          "name": "Instantaneous Acceleration",
          "latex": "a = \\frac{dv}{dt} = \\frac{d^2r}{dt^2} = v\\frac{dv}{dx}",
          "tags": ["kinematics", "acceleration", "calculus"]
        },
        {
          "id": "jee_p_1_3",
          "name": "Constant Acceleration 1D/2D",
          "latex": "v = u + at",
          "tags": ["kinematics", "equations of motion"]
        },
        {
          "id": "jee_p_1_4",
          "name": "Constant Acceleration 1D/2D (Displacement)",
          "latex": "r = r_0 + ut + \\frac{1}{2}at^2",
          "tags": ["kinematics", "equations of motion"]
        },
        {
          "id": "jee_p_1_5",
          "name": "Constant Acceleration 1D/2D (Velocity-Displacement)",
          "latex": "v^2 = u^2 + 2a\\cdot(r - r_0)",
          "tags": ["kinematics", "equations of motion"]
        },
        {
          "id": "jee_p_1_6",
          "name": "Displacement in nth second",
          "latex": "S_n = u + \\frac{a}{2}(2n - 1)",
          "description": "Sn = displacement in nth second",
          "tags": ["kinematics", "nth second"]
        },
        {
          "id": "jee_p_1_7",
          "name": "Circular Kinematics (2D Polar) Velocity",
          "latex": "\\frac{dr}{dt} = \\left(\\frac{dr}{dt}\\right)\\hat{e}_r + r\\omega \\hat{e}_t",
          "description": "er = radial unit vector, et = tangential unit vector",
          "tags": ["circular motion", "polar coordinates"]
        },
        {
          "id": "jee_p_1_8",
          "name": "Circular Kinematics (2D Polar) Acceleration",
          "latex": "\\frac{d^2r}{dt^2} = \\left[\\frac{d^2r}{dt^2} - r\\omega^2\\right]\\hat{e}_r + \\left[r\\frac{d\\omega}{dt} + 2\\omega\\frac{dr}{dt}\\right]\\hat{e}_t",
          "description": "Normal acceleration an = \u03c9\u00b2r = v\u00b2/r; Tangential at = dv/dt = r\u03b1",
          "tags": ["circular motion", "polar coordinates"]
        },
        {
          "id": "jee_p_1_9",
          "name": "Radius of Curvature",
          "latex": "R = \\frac{v^2}{a_n} = \\frac{[1 + (dy/dx)^2]^{3/2}}{|d^2y/dx^2|}",
          "description": "an = component of acceleration \u22a5 velocity",
          "tags": ["radius of curvature", "kinematics"]
        },
        {
          "id": "jee_p_1_10",
          "name": "Standard Projectile Motion (Trajectory)",
          "latex": "y = x \\tan\\theta - \\left[\\frac{g}{2u^2\\cos^2\\theta}\\right] x^2",
          "tags": ["projectile", "trajectory"]
        },
        {
          "id": "jee_p_1_11",
          "name": "Standard Projectile Motion (Time of Flight)",
          "latex": "T = \\frac{2u \\sin\\theta}{g}",
          "tags": ["projectile", "time of flight"]
        },
        {
          "id": "jee_p_1_12",
          "name": "Standard Projectile Motion (Max Height)",
          "latex": "H_{max} = \\frac{u^2\\sin^2\\theta}{2g}",
          "tags": ["projectile", "height"]
        },
        {
          "id": "jee_p_1_13",
          "name": "Standard Projectile Motion (Range)",
          "latex": "R = \\frac{u^2\\sin(2\\theta)}{g}",
          "description": "Max range Rmax = u\u00b2/g at \u03b8 = 45\u00b0. Same range for complementary angles \u03b8 and (90\u00b0 - \u03b8).",
          "tags": ["projectile", "range"]
        },
        {
          "id": "jee_p_1_14",
          "name": "Projectile on Incline (angle \u03b2) - Time of Flight",
          "latex": "T = \\frac{2u \\sin(\\alpha - \\beta)}{g \\cos\\beta}",
          "description": "\u03b1 = launch angle with horizontal, \u03b2 = incline angle.",
          "tags": ["projectile on incline"]
        },
        {
          "id": "jee_p_1_15",
          "name": "Projectile on Incline (angle \u03b2) - Range",
          "latex": "R = \\left[\\frac{u^2}{g \\cos^2\\beta}\\right] [\\sin(2\\alpha - \\beta) - \\sin\\beta]",
          "description": "Rmax(up) = u\u00b2 / [g(1 + sin\u03b2)]. Rmax(down) = u\u00b2 / [g(1 - sin\u03b2)]. Max range condition: 2\u03b1 - \u03b2 = 90\u00b0 \u21d2 \u03b1 = 45\u00b0 + \u03b2/2.",
          "tags": ["projectile on incline"]
        },
        {
          "id": "jee_p_1_16",
          "name": "Relative Motion & Frames",
          "latex": "r_{P/S'} = r_{P/S} - r_{S'/S}",
          "description": "vP/S' = vP/S - vS'/S, aP/S' = aP/S - aS'/S. S = stationary frame, S' = moving frame.",
          "tags": ["relative motion"]
        },
        {
          "id": "jee_p_1_17",
          "name": "Shortest distance between moving bodies",
          "latex": "d_{min} = \\frac{|r_{12} \\times v_{12}|}{|v_{12}|}",
          "tags": ["relative motion", "shortest distance"]
        },
        {
          "name": "Equations of Motion",
          "latex": "v = u + at; \\quad s = ut + \\frac{1}{2}at^2; \\quad v^2 = u^2 + 2as",
          "tags": ["kinematics", "motion"],
          "id": "jee_p_ch1_add_18"
        },
        {
          "name": "Relative Velocity",
          "latex": "v_{AB} = v_A - v_B",
          "tags": ["kinematics", "relative"],
          "id": "jee_p_ch1_add_19"
        },
        {
          "name": "Projectile Range",
          "latex": "R = \\frac{u^2\\sin 2\\theta}{g}",
          "tags": ["projectile", "range"],
          "id": "jee_p_ch1_add_20"
        },
        {
          "name": "Projectile Max Height",
          "latex": "H = \\frac{u^2\\sin^2\\theta}{2g}",
          "tags": ["projectile", "height"],
          "id": "jee_p_ch1_add_21"
        },
        {
          "name": "Projectile on Incline",
          "latex": "R = \\frac{2u^2\\sin\\alpha\\cdot\\cos(\\alpha+\\beta)}{g\\cdot\\cos^2\\beta}",
          "tags": ["projectile", "incline"],
          "id": "jee_p_ch1_add_22"
        },
        {
          "name": "River Crossing (min time)",
          "latex": "t = \\frac{d}{v_{swim}}; \\quad \\text{Drift} = \\left(\\frac{v_{river}}{v_{swim}}\\right)\\times d",
          "tags": ["river"],
          "id": "jee_p_ch1_add_23"
        },
        {
          "name": "Circular Motion (Centripetal)",
          "latex": "a_c = \\frac{v^2}{r} = \\omega^2r",
          "tags": ["circular"],
          "id": "jee_p_ch1_add_24"
        }
      ],
      "keyPoints": [
        "The tangential acceleration at changes speed; normal acceleration an changes direction of motion.",
        "In river-swimmer problems: Minimum time to cross tmin = d / vs (swim \u22a5 bank); Zero drift condition: sin\u03b8 = vr / vs (possible only if vs > vr)."
      ]
    },
    {
      "id": "jee_p_ch2",
      "class": "11",
      "name": "Laws of Motion, Friction & Variable Mass Systems",
      "formulas": [
        {
          "id": "jee_p_2_1",
          "name": "Newton's Second Law & Momentum",
          "latex": "F_{ext} = \\frac{dp}{dt} = m\\frac{dv}{dt} + v\\frac{dm}{dt}",
          "description": "For constant mass: F = ma.",
          "tags": ["newtons laws", "momentum"]
        },
        {
          "id": "jee_p_2_2",
          "name": "Impulse-Momentum Theorem",
          "latex": "J = \\int F dt = \\Delta p = p_f - p_i",
          "description": "Area under F-t curve equals impulse.",
          "tags": ["impulse", "momentum"]
        },
        {
          "id": "jee_p_2_3",
          "name": "Friction Laws (Static)",
          "latex": "f_s \\le f_{s,max} = \\mu_s N",
          "description": "Angle of friction: tan\u03bb = \u03bcs.",
          "tags": ["friction", "static"]
        },
        {
          "id": "jee_p_2_4",
          "name": "Friction Laws (Kinetic)",
          "latex": "f_k = \\mu_k N",
          "description": "\u03bck \u2264 \u03bcs. Angle of repose on incline: \u03b8 = \u03bb = tan\u207b\u00b9(\u03bcs).",
          "tags": ["friction", "kinetic"]
        },
        {
          "id": "jee_p_2_5",
          "name": "Variable Mass & Rocket Propulsion",
          "latex": "m \\frac{dv}{dt} = F_{ext} + v_{rel} \\frac{dm}{dt}",
          "description": "Fthrust = vrel (dm/dt). vrel = exhaust gas velocity relative to rocket. Thrust force Fth = \u03bb ve where \u03bb = -dm/dt.",
          "tags": ["rocket", "variable mass"]
        },
        {
          "id": "jee_p_2_6",
          "name": "Rocket Velocity",
          "latex": "v = v_0 + v_{rel} \\ln\\left(\\frac{m_0}{m}\\right) - gt",
          "tags": ["rocket", "velocity"]
        },
        {
          "id": "jee_p_2_7",
          "name": "Banking of Circular Tracks",
          "latex": "v_{max} = \\sqrt{R g \\left(\\frac{\\mu_s + \\tan\\theta}{1 - \\mu_s\\tan\\theta}\\right)}",
          "description": "Level road: vmax = \u221a(\u03bcs R g). Optimum speed: v0 = \u221a(R g tan\u03b8). \u03b8 = banking angle of road.",
          "tags": ["banking", "circular track", "friction"]
        },
        {
          "name": "Newton's 2nd Law",
          "latex": "F = ma = \\frac{dp}{dt}",
          "tags": ["newtons laws"],
          "id": "jee_p_ch2_add_8"
        },
        {
          "name": "Friction",
          "latex": "f \\le \\mu N; \\quad f_{kinetic} = \\mu_k N",
          "tags": ["friction"],
          "id": "jee_p_ch2_add_9"
        },
        {
          "name": "Pseudo Force",
          "latex": "F_{pseudo} = -ma_{frame}",
          "tags": ["pseudo force"],
          "id": "jee_p_ch2_add_10"
        },
        {
          "name": "Pulley (Atwood)",
          "latex": "a = \\frac{(m_1 - m_2)g}{m_1 + m_2}; \\quad T = \\frac{2m_1m_2g}{m_1 + m_2}",
          "tags": ["pulley"],
          "id": "jee_p_ch2_add_11"
        },
        {
          "name": "Banking Angle",
          "latex": "\\tan \\theta = \\frac{v^2}{rg}",
          "tags": ["banking"],
          "id": "jee_p_ch2_add_12"
        },
        {
          "name": "Spring Force",
          "latex": "F = -kx",
          "tags": ["spring"],
          "id": "jee_p_ch2_add_13"
        },
        {
          "name": "Impulse",
          "latex": "J = F\\Delta t = \\Delta p",
          "tags": ["impulse"],
          "id": "jee_p_ch2_add_14"
        },
        {
          "name": "Conical Pendulum",
          "latex": "T = 2\\pi\\sqrt{\\frac{L \\cos\\theta}{g}}",
          "tags": ["pendulum"],
          "id": "jee_p_ch2_add_15"
        }
      ]
    },
    {
      "id": "jee_p_ch3",
      "class": "11",
      "name": "Work, Energy, Power & Vertical Circular Motion",
      "formulas": [
        {
          "id": "jee_p_3_1",
          "name": "Work Done",
          "latex": "W = \\int F \\cdot dr = \\int (F_x dx + F_y dy + F_z dz)",
          "description": "Conservative force \u21d4 \u222e F \u00b7 dr = 0 \u21d4 \u2207 \u00d7 F = 0.",
          "tags": ["work", "integration"]
        },
        {
          "id": "jee_p_3_2",
          "name": "Work-Energy Theorem",
          "latex": "W_{net} = W_{conservative} + W_{non-conservative} + W_{pseudo} = \\Delta K",
          "description": "General for all frames of reference.",
          "tags": ["work energy theorem"]
        },
        {
          "id": "jee_p_3_3",
          "name": "Potential Energy",
          "latex": "F = -\\nabla U = -\\left(\\frac{\\partial U}{\\partial x}\\hat{i} + \\frac{\\partial U}{\\partial y}\\hat{j} + \\frac{\\partial U}{\\partial z}\\hat{k}\\right)",
          "description": "U(x) = -\u222b F dx. Spring potential energy: U = \u00bdkx\u00b2.",
          "tags": ["potential energy", "gradient"]
        },
        {
          "id": "jee_p_3_4",
          "name": "Power",
          "latex": "P = \\frac{dW}{dt} = F \\cdot v",
          "description": "Pavg = Wtotal / \u0394t. Unit: Watt (W); 1 hp = 746 W.",
          "tags": ["power"]
        },
        {
          "id": "jee_p_3_5",
          "name": "Vertical Circular Motion (String L) - Bottom speed",
          "latex": "u \\ge \\sqrt{5gL}",
          "description": "Bottom speed for complete loop.",
          "tags": ["vertical circular motion", "speed"]
        },
        {
          "id": "jee_p_3_6",
          "name": "Vertical Circular Motion (String L) - Top speed",
          "latex": "v_{top} \\ge \\sqrt{gL}",
          "tags": ["vertical circular motion", "speed"]
        },
        {
          "id": "jee_p_3_7",
          "name": "Vertical Circular Motion (String L) - Tension",
          "latex": "T = mg \\cos\\theta + \\frac{mv^2}{L}",
          "description": "Tension at angle \u03b8 from bottom. Tbottom - Ttop = 6mg. For light rigid rod: umin at bottom = \u221a(4gL) = 2\u221a(gL).",
          "tags": ["vertical circular motion", "tension"]
        },
        {
          "name": "Work Done",
          "latex": "W = F\\cdot d\\cdot\\cos\\theta = \\int F\\cdot ds",
          "tags": ["work"],
          "id": "jee_p_ch3_add_8"
        },
        {
          "name": "Kinetic Energy",
          "latex": "KE = \\frac{1}{2}mv^2",
          "tags": ["kinetic energy"],
          "id": "jee_p_ch3_add_9"
        },
        {
          "name": "Gravitational PE",
          "latex": "U = -\\frac{GMm}{r} \\quad \\text{(from infinity)}; \\quad U = mgh \\quad \\text{(near surface)}",
          "tags": ["potential energy"],
          "id": "jee_p_ch3_add_10"
        },
        {
          "name": "Spring PE",
          "latex": "U = \\frac{1}{2}kx^2",
          "tags": ["spring energy"],
          "id": "jee_p_ch3_add_11"
        },
        {
          "name": "Power",
          "latex": "P = \\frac{W}{t} = F\\cdot v",
          "tags": ["power"],
          "id": "jee_p_ch3_add_12"
        },
        {
          "name": "Coefficient of Restitution",
          "latex": "e = -\\frac{(v_2 - v_1)}{(u_2 - u_1)}",
          "tags": ["restitution"],
          "id": "jee_p_ch3_add_13"
        },
        {
          "name": "Elastic Collision (1D)",
          "latex": "v_1 = \\frac{(m_1-m_2)u_1 + 2m_2u_2}{m_1+m_2}",
          "tags": ["collision"],
          "id": "jee_p_ch3_add_14"
        }
      ]
    },
    {
      "id": "jee_p_ch4",
      "class": "11",
      "name": "Conservation of Momentum & Center of Mass (COM)",
      "formulas": [
        {
          "id": "jee_p_4_1",
          "name": "Center of Mass (Continuous)",
          "latex": "r_{cm} = \\frac{1}{M} \\int r dm",
          "description": "xcm = (1/M)\u222b x dm, ycm = (1/M)\u222b y dm.",
          "tags": ["center of mass", "integration"]
        },
        {
          "id": "jee_p_4_2",
          "name": "Impulse & Collisions (1D) Coefficient of Restitution",
          "latex": "e = \\frac{v_2 - v_1}{u_1 - u_2}",
          "tags": ["collision", "restitution"]
        },
        {
          "id": "jee_p_4_3",
          "name": "Final Velocities in 1D Collision",
          "latex": "v_1 = \\left(\\frac{m_1 - e m_2}{m_1 + m_2}\\right) u_1 + \\left(\\frac{m_2(1 + e)}{m_1 + m_2}\\right) u_2",
          "description": "e = 1 (elastic), e = 0 (perfectly inelastic), 0 < e < 1 (inelastic).",
          "tags": ["collision", "velocity"]
        },
        {
          "id": "jee_p_4_4",
          "name": "Final Velocities in 1D Collision (v2)",
          "latex": "v_2 = \\left(\\frac{m_1(1 + e)}{m_1 + m_2}\\right) u_1 + \\left(\\frac{m_2 - e m_1}{m_1 + m_2}\\right) u_2",
          "tags": ["collision", "velocity"]
        },
        {
          "id": "jee_p_4_5",
          "name": "Energy Loss in Inelastic Collision",
          "latex": "\\Delta E = \\frac{1}{2} \\left[\\frac{m_1m_2}{m_1 + m_2}\\right] (1 - e^2) (u_1 - u_2)^2",
          "description": "\u03bc = m1m2/(m1+m2) is reduced mass.",
          "tags": ["collision", "energy loss"]
        }
      ],
      "keyPoints": [
        "Uniform semicircular ring: ycm = 2R/\u03c0",
        "Uniform semicircular disc: ycm = 4R/(3\u03c0)",
        "Hemispherical shell: ycm = R/2",
        "Solid hemisphere: ycm = 3R/8",
        "Solid cone (height h): ycm = h/4"
      ]
    },
    {
      "id": "jee_p_ch5",
      "class": "11",
      "name": "Rotational Mechanics",
      "formulas": [
        {
          "id": "jee_p_5_1",
          "name": "Moment of Inertia (Thin Ring)",
          "latex": "I = MR^2",
          "description": "Radius R, central axis. Radius of Gyration (k) = R",
          "tags": ["moment of inertia", "ring"]
        },
        {
          "id": "jee_p_5_2",
          "name": "Moment of Inertia (Circular Disc)",
          "latex": "I = \\frac{1}{2}MR^2",
          "description": "Radius R, central axis. Radius of Gyration (k) = R/\u221a2",
          "tags": ["moment of inertia", "disc"]
        },
        {
          "id": "jee_p_5_3",
          "name": "Moment of Inertia (Solid Sphere)",
          "latex": "I = \\frac{2}{5}MR^2",
          "description": "Radius R, diameter. Radius of Gyration (k) = \u221a(2/5) R",
          "tags": ["moment of inertia", "sphere"]
        },
        {
          "id": "jee_p_5_4",
          "name": "Moment of Inertia (Hollow Spherical Shell)",
          "latex": "I = \\frac{2}{3}MR^2",
          "description": "Diameter. Radius of Gyration (k) = \u221a(2/3) R",
          "tags": ["moment of inertia", "shell"]
        },
        {
          "id": "jee_p_5_5",
          "name": "Moment of Inertia (Thin Rod, center)",
          "latex": "I = \\frac{1}{12}ML^2",
          "description": "Length L, perpendicular through center. Radius of Gyration (k) = L/\u221a12",
          "tags": ["moment of inertia", "rod"]
        },
        {
          "id": "jee_p_5_6",
          "name": "Moment of Inertia (Thin Rod, end)",
          "latex": "I = \\frac{1}{3}ML^2",
          "description": "Length L, perpendicular through end. Radius of Gyration (k) = L/\u221a3",
          "tags": ["moment of inertia", "rod"]
        },
        {
          "id": "jee_p_5_7",
          "name": "Parallel Axis Theorem",
          "latex": "I = I_{cm} + Md^2",
          "description": "d = distance between parallel axes",
          "tags": ["moment of inertia", "parallel axis theorem"]
        },
        {
          "id": "jee_p_5_8",
          "name": "Perpendicular Axis Theorem",
          "latex": "I_z = I_x + I_y",
          "description": "Valid for planar laminar bodies in xy-plane",
          "tags": ["moment of inertia", "perpendicular axis theorem"]
        },
        {
          "id": "jee_p_5_9",
          "name": "Torque & Angular Momentum",
          "latex": "\\tau = r \\times F = I\\alpha",
          "description": "L = r \u00d7 p = I\u03c9",
          "tags": ["torque", "angular momentum"]
        },
        {
          "id": "jee_p_5_10",
          "name": "Rate of change of Angular Momentum",
          "latex": "\\tau_{ext} = \\frac{dL}{dt}",
          "description": "Conservation of Angular Momentum: \u03c4ext = 0 \u21d2 L = const.",
          "tags": ["torque", "angular momentum"]
        },
        {
          "id": "jee_p_5_11",
          "name": "Pure Rolling on Incline (Acceleration)",
          "latex": "a_{cm} = \\frac{g \\sin\\theta}{1 + k^2/R^2}",
          "tags": ["rolling", "acceleration"]
        },
        {
          "id": "jee_p_5_12",
          "name": "Pure Rolling on Incline (Friction & \u03bc_min)",
          "latex": "f_{friction} = \\frac{mg \\sin\\theta (k^2/R^2)}{1 + k^2/R^2}",
          "description": "\u03bcmin = [tan\u03b8 (k^2/R^2)] / (1 + k^2/R^2)",
          "tags": ["rolling", "friction"]
        },
        {
          "id": "jee_p_5_13",
          "name": "Pure Rolling on Incline (Velocity & Energy)",
          "latex": "v_{cm} = \\sqrt{\\frac{2gh}{1 + k^2/R^2}}",
          "description": "Total KE: K = \u00bdMvcm\u00b2(1 + k\u00b2/R\u00b2)",
          "tags": ["rolling", "velocity", "kinetic energy"]
        },
        {
          "name": "Angular Momentum",
          "latex": "L = I\\omega = mvr",
          "tags": ["angular momentum"],
          "id": "jee_p_ch6_add_12"
        },
        {
          "name": "MOI (Rod, center)",
          "latex": "I = \\frac{ML^2}{12}",
          "tags": ["moi"],
          "id": "jee_p_ch6_add_16"
        },
        {
          "name": "Rolling (No Slip)",
          "latex": "v = R\\omega; \\quad a = R\\alpha",
          "tags": ["rolling"],
          "id": "jee_p_ch6_add_18"
        },
        {
          "name": "KE of Rolling Body",
          "latex": "KE = \\frac{1}{2}mv^2\\left(1 + \\frac{k^2}{R^2}\\right)",
          "tags": ["rolling energy"],
          "id": "jee_p_ch6_add_19"
        },
        {
          "name": "Newton's Gravity",
          "latex": "F = \\frac{GMm}{r^2}",
          "tags": ["gravity"],
          "id": "jee_p_ch6_add_20"
        },
        {
          "name": "Orbital Velocity",
          "latex": "v_0 = \\sqrt{\\frac{GM}{r}} = \\sqrt{gR}",
          "tags": ["orbital velocity"],
          "id": "jee_p_ch6_add_21"
        },
        {
          "name": "Escape Velocity",
